+						if (geo_cert && !scoreprobed && geo_probe > 0 && (qe - qs >= geo_probe || re - rs >= geo_probe)) { // score-only first pass
+							mm_align_pair(km, opt, qe - qs, qseq, re - rs, tseq, junc, mat, gb, -1, opt->zdrop, extra_flag|KSW_EZ_APPROX_MAX|KSW_EZ_SCORE_ONLY, ez);
+							++natt; scoreprobed = 1;
