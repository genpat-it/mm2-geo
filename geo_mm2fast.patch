+// mm2-geo band-doubling grafted onto mm2-fast (env MM2_GEO=1, MM2_GEO_MARGIN default 20)
+static int mm_geo_enabled(void){ static int v=-1; if(v<0){const char*e=getenv("MM2_GEO"); v=(e&&*e&&atoi(e))?1:0;} return v; }
+static int mm_geo_margin(void){ static int m=-1; if(m<0){const char*e=getenv("MM2_GEO_MARGIN"); m=(e&&*e)?atoi(e):20; if(m<0)m=0;} return m; }
+// certified acceptance (MM2_GEO_CERT=1): any path leaving the band |i-j|<=b contains an insertion and a deletion run
+// totalling >= (b+1)+(b+1-d), so it scores at most U(b) = a*floor((ql+tl-L)/2) - g(b+1) - g(b+1-d); accept when S >= U(b),
+// otherwise realign once with the smallest band that the bound certifies.
+static int mm_geo_cert(void){ static int v=-1; if(v<0){const char*e=getenv("MM2_GEO_CERT"); v=(e&&*e)?atoi(e):0;} return v; }
+static inline int mm_geo_gcost(const mm_mapopt_t *o, int l){ int c1 = o->q + l * o->e, c2 = o->q2 + l * o->e2; return c1 < c2? c1 : c2; }
+static inline long long mm_geo_cert_ub(const mm_mapopt_t *o, int ql, int tl, int b, int d){
+	int L1 = b + 1, L2 = b + 1 - d, L;
+	if (L2 < 1) L2 = 1;
+	L = L1 + L2;
+	if (L > ql + tl) return -(1LL<<40);
+	return (long long)o->a * ((ql + tl - L) / 2) - mm_geo_gcost(o, L1) - mm_geo_gcost(o, L2);
+}
+static int mm_geo_cert_band(const mm_mapopt_t *o, int ql, int tl, int d, long long s, int lo, int hi){
+	if (mm_geo_cert_ub(o, ql, tl, hi, d) > s) return hi;
+	while (hi - lo > 1) { int mid = lo + (hi - lo) / 2; if (mm_geo_cert_ub(o, ql, tl, mid, d) <= s) hi = mid; else lo = mid; }
+	return hi;
+}
