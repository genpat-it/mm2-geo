+// mm2-geo: geometry-guided band-doubling. Each gap's DP band is sized from the anchor
+// drift (|dq - dr| + margin) instead of minimap2's global -r, and doubled on boundary
+// contact up to minimap2's own bandwidth; ksw2 still fills the band, so indel placement
+// stays accurate. Gated by MM2_GEO=1 (MM2_GEO_MARGIN sets the margin, default 20);
+// with MM2_GEO unset/0 this build is stock minimap2.
+static int mm_geo_enabled(void)
+{
+	static int v = -1;
+	if (v < 0) { const char *e = getenv("MM2_GEO"); v = (e && *e && atoi(e) != 0)? 1 : 0; }
+	return v;
+}
+static int mm_geo_margin(void)
+{
+	static int m = -1;
+	if (m < 0) { const char *e = getenv("MM2_GEO_MARGIN"); m = (e && *e)? atoi(e) : 20; if (m < 0) m = 0; }
+	return m;
+}
